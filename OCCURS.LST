   115	      PROCEDURE DIVISION.
   116	      MAIN-RTN.
   117		  PERFORM INIT-RTN.
   118		  PERFORM PROCESS-RTN UNTIL EOFSW = 1.
   119		  PERFORM FINISH-RTN.
   120		  STOP RUN.   121											12DEC25 09:08:18  PAGE	  3
   122	      INIT-RTN.
   123		  OPEN INPUT STUDENT OUTPUT OUTFILE.
   124
   125		  READ STUDENT
   126		      AT END MOVE 1 TO EOFSW
   127		  END-READ.
   128
   129		  IF EOFSW = 1
   130                DISPLAY "EMPTY FILE"
   131		      GO TO INIT-DONE
   132		  END-IF
   133
   134		  PERFORM HEADING-RTN.
   135
   136	      INIT-DONE.
   137		  EXIT.
   138
   139	      HEADING-RTN.
   140		  WRITE OUTREC FROM HEAD-1 AFTER PAGE.
   141		  WRITE OUTREC FROM HEAD-2 AFTER 1.
   142		  WRITE OUTREC FROM SUBHEAD-1 AFTER 2.
   143		  WRITE OUTREC FROM SUBHEAD-2 AFTER 1.
   144		  MOVE 0 TO PAGE-COUNT.
   145		  EXIT.
   146
   147	      PROCESS-RTN.
   148		  MOVE SNO TO P-SNO.
   149		  MOVE SNA TO P-SNA.
   150
   151		  MOVE 0 TO WS-TOTAL.
   152
   153		  PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
   154		  MOVE QUIZ(I) TO PRT-QV(I)
   155		  ADD QUIZ(I) TO WS-TOTAL
   156		  END-PERFORM
   157
   158
   159		  COMPUTE WS-AVE = WS-TOTAL / 5.
   160		  MOVE WS-AVE TO P-AVE.
   161
   162		  WRITE OUTREC FROM DETALYE AFTER 1.
   163
   164		  ADD 1 TO REC-COUNT.
   165		  ADD 1 TO PAGE-COUNT.
   166
   167		  READ STUDENT
   168		      AT END MOVE 1 TO EOFSW
   169		  END-READ.
   170
   171		  IF PAGE-COUNT = 10
   172		      PERFORM HEADING-RTN
   173		  END-IF.
   174		  EXIT.
   175
   176	      FINISH-RTN.
   177	     *	  MOVE REC-COUNT TO P-TOT.
   178
   179	     *	  WRITE OUTREC FROM BLANK-LINE AFTER 2.
   180	     *	  WRITE OUTREC FROM TOTAL-LINE AFTER 1.   181											12DEC25 09:08:18  PAGE	  4
   182		  CLOSE STUDENT OUTFILE.
   183            DISPLAY "REPORT COMPLETE.".
   184		  EXIT.Realia COBOL Version 4.000   SN: 01-07732  C:OCCURS.COB 				12DEC25 09:08:18  PAGE	  5



