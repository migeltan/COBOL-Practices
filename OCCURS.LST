     4	     *AUTHOR. MIGEL H. TAN.
     5	     *REMARKS. STUDENT QUIZ REPORT WITH TABLE HANDLING.
     6
     7	      ENVIRONMENT DIVISION.
     8	      INPUT-OUTPUT SECTION.
     9	      FILE-CONTROL.
    10            SELECT STUDENT ASSIGN TO "STUDQ.TXT".
    11            SELECT OUTFILE ASSIGN TO "REPQ".
    12
    13	      DATA DIVISION.
    14	      FILE SECTION.
    15
    16	      FD STUDENT
    17		  LABEL RECORD IS STANDARD
    18		  DATA RECORD IS INREC.
    19
    20	      01 INREC.
    21		  02 SNO PIC 9(5).
    22		  02 SNA PIC X(25).
    23		  02 QUIZ OCCURS 5 TIMES PIC 99.
    24
    25	      FD OUTFILE
    26		  LABEL RECORD IS OMITTED
    27		  DATA RECORD IS OUTREC.
    28
    29	      01 OUTREC.
    30		  02 FILLER PIC X(80).
    31
    32	      WORKING-STORAGE SECTION.
    33
    34	      01 EOFSW	     PIC 9 VALUE 0.
    35	      01 PAGE-COUNT  PIC 9(2) VALUE 0.
    36	      01 REC-COUNT   PIC 9(3) VALUE 0.
    37
    38	      01 WS-TOTAL    PIC 9(3) VALUE 0.
    39	      01 WS-AVE      PIC 99V99.
    40	      01 I	     PIC 9 VALUE 1.
    41
    42	      01 PRT-TABLE.
    43		  02 PRT-SNO PIC 9(5).
    44		  02 PRT-SNA PIC X(25).
    45		  02 PRT-Q OCCURS 5 TIMES.
    46		     03 PRT-QUIZ PIC ZZ.
    47		  02 PRT-AVE PIC 99.99.
    48
    49	      01 HEAD-1.
    50		  02 FILLER PIC X(36) VALUE SPACES.
    51            02 FILLER PIC X(10) VALUE "puP".
    52		  02 FILLER PIC X(35) VALUE SPACES.
    53
    54	      01 HEAD-2.
    55		  02 FILLER PIC X(35) VALUE SPACES.
    56            02 FILLER PIC X(12) VALUE "ccis".
    57		  02 FILLER PIC X(30) VALUE SPACES.
