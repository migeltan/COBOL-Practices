   104	      UNI-RTN.
   105            DISPLAY 'University Code: ' LINE 11 COLUMN 10.
   106		  ACCEPT UNC LINE 11 COLUMN 50.
   107		  EVALUATE UNC
   108		   WHEN 1
   109             MOVE 'UP' TO UNA
   110		   WHEN 2
   111             MOVE 'PUP' TO UNA
   112		   WHEN 3
   113             MOVE 'DLSU' TO UNA
   114		   WHEN 4
   115             MOVE 'ADMU' TO UNA
   116		   WHEN 5
   117             MOVE 'MAPUA' TO UNA
   118		   WHEN OTHER
   119             DISPLAY '1-5 Only!' LINE 11 COLUMN 40
   120		   GO TO UNI-RTN   121		  END-EVALUATE. 							28JAN26 01:06:06  PAGE	  3
   122
   123            DISPLAY 'University Name: ' LINE 12 COLUMN 10.
   124		  DISPLAY UNA LINE 12 COLUMN 50.
   125
   126	      CC-RTN.
   127            DISPLAY 'Course Code: ' LINE 13 COLUMN 10.
   128		  ACCEPT CC LINE 13 COLUMN 50.
   129		  EVALUATE CC
   130		   WHEN 1
   131             MOVE 'BSIT' TO CNA
   132		   WHEN 2
   133             MOVE 'BSCS' TO CNA
   134		   WHEN 3
   135             MOVE 'BSIS' TO CNA
   136		   WHEN OTHER
   137             DISPLAY '1-3 Only!' LINE 13 COLUMN 40
   138		   GO TO CC-RTN
   139		  END-EVALUATE.
   140
   141            DISPLAY 'Course Name: ' LINE 14 COLUMN 10.
   142		  DISPLAY CNA LINE 14 COLUMN 50.
   143
   144	      TOTAL-RTN.
   145            DISPLAY 'Total No. of Items: ' LINE 15 COLUMN 10.
   146		  ACCEPT TOTITEMS LINE 15 COLUMN 50.
   147		  IF TOTITEMS < 1 OR TOTITEMS > 100
   148            DISPLAY '1-100 Only!' LINE 15 COLUMN 35
   149		  GO TO TOTAL-RTN
   150		  END-IF.
   151
   152	      TEST-RTN.
   153            DISPLAY 'Test Result (Score): ' LINE 16 COLUMN 10.
   154		  ACCEPT TESTR LINE 16 COLUMN 50.
   155		  IF TESTR IS LESS THAN 1 OR TESTR GREATER THAN TOTITEMS
   156                DISPLAY '1-100 Only!' LINE 16 COLUMN 35
   157		      GO TO TEST-RTN
   158		      END-IF.
   159
   160	      REM-RTN.
   161            DISPLAY 'Remarks: ' LINE 17 COLUMN 10.
   162		  COMPUTE RAVERAGE = (TESTR / TOTITEMS) * 100
   163
   164		  IF CC = 1 AND RAVERAGE IS GREATER THAN OR EQUAL 60
   165            MOVE 'PASSED' TO REM
   166		  ADD 1 TO TOTPASSED
   167		  EVALUATE UNC
   168		   WHEN 1 ADD 1 TO UP-PASSED
   169		   WHEN 2 ADD 1 TO PUP-PASSED
   170		   WHEN 3 ADD 1 TO DLSU-PASSED
   171		   WHEN 4 ADD 1 TO ADMU-PASSED
   172		   WHEN 5 ADD 1 TO MAPUA-PASSED
   173		  END-EVALUATE
   174		   ELSE IF CC = 1 AND RAVERAGE IS LESS THAN 60
   175             MOVE 'FAILED' TO REM
   176		   ADD 1 TO TOTFAILED
   177		  END-IF.
   178
   179		   IF CC = 2 AND RAVERAGE IS GREATER THAN OR EQUAL 70
   180            MOVE 'PASSED' TO REM   181		  ADD 1 TO TOTPASSED							28JAN26 01:06:06  PAGE	  4
   182		  EVALUATE UNC
   183		   WHEN 1 ADD 1 TO UP-PASSED
   184		   WHEN 2 ADD 1 TO PUP-PASSED
   185		   WHEN 3 ADD 1 TO DLSU-PASSED
   186		   WHEN 4 ADD 1 TO ADMU-PASSED
   187		   WHEN 5 ADD 1 TO MAPUA-PASSED
   188		  END-EVALUATE
   189		  ELSE IF CC = 2 AND RAVERAGE IS LESS THAN 70
   190            MOVE 'FAILED' TO REM
   191		  ADD 1 TO TOTFAILED
   192		   END-IF.
   193
   194		  IF CC = 3 AND RAVERAGE IS GREATER THAN OR EQUAL 50
   195            MOVE 'PASSED' TO REM
   196		  ADD 1 TO TOTPASSED
   197		   EVALUATE UNC
   198		   WHEN 1 ADD 1 TO UP-PASSED
   199		   WHEN 2 ADD 1 TO PUP-PASSED
   200		   WHEN 3 ADD 1 TO DLSU-PASSED
   201		   WHEN 4 ADD 1 TO ADMU-PASSED
   202		   WHEN 5 ADD 1 TO MAPUA-PASSED
   203		  END-EVALUATE
   204		  ELSE IF CC = 3 AND RAVERAGE IS LESS THAN 50
   205            MOVE 'FAILED' TO REM
   206		   ADD 1 TO TOTFAILED
   207		  END-IF.
   208
   209		   DISPLAY REM LINE 17 COLUMN 50.
   210
   211		  EVALUATE UNC
   212		  WHEN 1 ADD 1 TO UP-PASSED
   213		  WHEN 2 ADD 1 TO PUP-PASSED
   214		  WHEN 3 ADD 1 TO DLSU-PASSED
   215		  WHEN 4 ADD 1 TO ADMU-PASSED
   216		  WHEN 5 ADD 1 TO MAPUA-PASSED
   217		  END-EVALUATE
   218
   219		  DISPLAY REM LINE 17 COLUMN 50.
