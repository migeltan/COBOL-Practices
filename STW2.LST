    31	      01  SCRE.
    32		  02 BLANK SCREEN.
    33
    34	      PROCEDURE DIVISION.
    35	      MAIN-RTN.
    36		  PERFORM INPUT-RTN UNTIL INDICATOR = 1.
    37		  STOP RUN.
    38
    39	      INPUT-RTN.
    40		  DISPLAY SCRE.
    41            DISPLAY 'PUP' LINE 1 COLUMN 40.
    42            DISPLAY 'CCIS' LINE 2 COLUMN 40.
    43
    44            DISPLAY 'Student Number: ' LINE 5 COLUMN 10.
    45		  ACCEPT SNO LINE 5 COLUMN 50.
    46
    47            DISPLAY 'Student Name: ' LINE 6 COLUMN 10.
    48		  ACCEPT SNA LINE 6 COLUMN 50.
    49
    50            DISPLAY 'Course: ' LINE 7 COLUMN 10.
    51		  ACCEPT CC LINE 7 COLUMN 50.
    52
    53            DISPLAY 'Year & Section: ' LINE 8 COLUMN 10.
    54		  ACCEPT YRSEC LINE 8 COLUMN 50.
    55
    56            DISPLAY 'Student Type: ' LINE 9 COLUMN 10.
    57		  ACCEPT STYPE LINE 9 COLUMN 50.
    58
    59            DISPLAY 'Midterm Grade: ' LINE 10 COLUMN 10.
    60		  ACCEPT MG LINE 10 COLUMN 50.    61											09JAN26 20:46:02  PAGE	  2
    62            DISPLAY 'Final Grade: ' LINE 11 COLUMN 10.
    63		  ACCEPT FG LINE 11 COLUMN 50.
    64
    65		  COMPUTE AVE = (MG + FG) / 2.
    66		  MOVE AVE TO AVE-R.
    67
    68            DISPLAY 'Average: ' LINE 12 COLUMN 10.
    69		  DISPLAY AVE-R LINE 12 COLUMN 50.
    70
    71		  IF AVE > 3.00
    72                MOVE "FAILED" TO REM-I
    73		  ELSE
    74                MOVE "PASSED" TO REM-I
    75		  END-IF.
    76
    77            DISPLAY 'Remarks: ' LINE 13 COLUMN 10.
    78		  DISPLAY REM-I LINE 13 COLUMN 50.
    79
    80            DISPLAY "Enter Another Record (Y/N): " LINE 15 COLUMN 10.
    81		  ACCEPT DEC LINE 15 COLUMN 50.
    82
    83            IF DEC IS = 'Y'
    84		      MOVE 0 TO AVE
    85		      MOVE SPACES TO REM-I
    86            ELSE IF DEC IS = 'N'
    87		      MOVE 1 TO INDICATOR
    88		  END-IF.Realia COBOL Version 4.000   SN: 01-07732  C:STW2.COB					09JAN26 20:46:02  PAGE	  3



