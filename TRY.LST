    89	      COURSE-UNI-RTN.
    90
    91	      UNI-RTN.
    92            DISPLAY "Enter your university code: " LINE 9 COLUMN 5.
    93		  ACCEPT UC LINE 9 COLUMN 60.
    94		  EVALUATE UC
    95		   WHEN 1
    96             MOVE "UP" TO UNA
    97		   WHEN 2
    98             MOVE "ADMU" TO UNA
    99		   WHEN 3
   100             MOVE "DLSU" TO UNA
   101		   WHEN 4
   102             MOVE "UST" TO UNA
   103		   WHEN 5
   104             MOVE "PUP" TO UNA
   105		   WHEN 6
   106             MOVE "MAPUA" TO UNA
   107		   WHEN 7
   108             MOVE "FEU" TO UNA
   109		   WHEN OTHER
   110             DISPLAY "1-7 Only!" LINE 9 COLUMN 25
   111		   GO TO UNI-RTN
   112		  END-EVALUATE.
   113
   114            DISPLAY "University: " LINE 10 COLUMN 5.
   115		  DISPLAY UNA LINE 10 COLUMN 60.
   116
   117	      COURSE-RTN.
   118            DISPLAY "Enter your program code: " LINE 11 COLUMN 5.
   119		  ACCEPT CC LINE 11 COLUMN 60.
   120		  EVALUATE CC   121		   WHEN 1								04MAR26 23:47:46  PAGE	  3
   122             MOVE "BSCS" TO CNA
   123		   WHEN 2
   124             MOVE "BSIT" TO CNA
   125		   WHEN 3
   126             MOVE "BSIS" TO CNA
   127		   WHEN 4
   128             MOVE "BSCpE" TO CNA
   129		   WHEN OTHER
   130             DISPLAY "1-4 Only!" LINE 11 COLUMN 25
   131		   GO TO COURSE-RTN
   132		  END-EVALUATE.
   133
   134            DISPLAY "Program: " LINE 12 COLUMN 5.
   135		  DISPLAY CNA LINE 12 COLUMN 60.
   136
   137	      COURSE-UNI-RTN-END.
   138
   139	      GRADE-RTN.
   140
   141	      MID-RTN.
   142            DISPLAY "Enter your midterm grade: " LINE 13 COLUMN 5.
   143		  ACCEPT MID LINE 13 COLUMN 60.
   144		  IF MID < 1.00 OR MID > 5.00
   145                DISPLAY "1.00 - 5.00 only!" LINE 13 COLUMN 35
   146		      GO TO MID-RTN
   147		      END-IF.
   148
   149	      FIN-RTN.
   150            DISPLAY "Enter your final grade: " LINE 14 COLUMN 5.
   151		  ACCEPT FIN LINE 14 COLUMN 60.
   152		  IF FIN < 1.00 OR FIN > 5.00
   153                DISPLAY "1.00 - 5.00 only!" LINE 14 COLUMN 25
   154		      GO TO FIN-RTN
   155		      END-IF.
   156
   157	      REM-RTN.
   158		  COMPUTE AVE = (MID + FIN) / 2
   159            DISPLAY "Your average is: " LINE 15 COLUMN 5.
   160		  DISPLAY AVE LINE 15 COLUMN 60.
   161
   162            DISPLAY "Remarks: " LINE 16 COLUMN 5.
   163		  IF AVE > 1.00 AND AVE < 1.15
   164                DISPLAY "Summa Cum Laude!" LINE 16 COLUMN 60
   165                MOVE "Passed" TO REM
   166		  ELSE IF AVE > 1.15 AND AVE < 1.50
   167                DISPLAY "Magna Cum Laude!" LINE 16 COLUMN 60
   168                MOVE "Passed" TO REM
   169		  ELSE IF AVE > 1.50 AND AVE < 1.75
   170                DISPLAY "Cum Laude!" LINE 16 COLUMN 60
   171                MOVE "Passed" TO REM
   172		  ELSE IF AVE > 1.75 AND AVE < 3.00
   173                DISPLAY "Passed!" LINE 16 COLUMN 60
   174                MOVE "Passed" TO REM
   175		  ELSE
   176                DISPLAY "Failed." LINE 16 COLUMN 60
   177                MOVE "Failed" TO REM
   178		  END-IF
   179		  END-IF
   180		  END-IF   181		  END-IF.								04MAR26 23:47:46  PAGE	  4
   182	      GRADE-RTN-END.
   183
   184	      CONTINUE-RTN.
   185            DISPLAY 'Input Another Record? (Y/N): ' LINE 19 COLUMN 26.
   186		  ACCEPT ANOTHER LINE 19 COLUMN 55.
   187            IF ANOTHER = 'Y' OR ANOTHER = 'y'
   188		  MOVE 0 TO EOFSW
   189		  MOVE SPACES TO REM
   190		      ELSE
   191                IF ANOTHER = 'N' OR ANOTHER = 'n'
   192		      MOVE 1 TO EOFSW
   193			ELSE
   194                  DISPLAY 'Y or N only!' LINE 18 COLUMN 32
   195			GO TO CONTINUE-RTN
   196		     END-IF
   197		  END-IF.
   198
